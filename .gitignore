# ============================================
# Ignore EVERYTHING by default, then whitelist
# ============================================
*

# ── Whitelist: top-level config ──
!.gitignore
!.gitattributes
!README.md

# ── Whitelist: remote_monitoring (main project) ──
!Pruebas/
!Pruebas/src/
!Pruebas/src/remote_monitoring/
!Pruebas/src/remote_monitoring/*.py
!Pruebas/src/remote_monitoring/*.cpp
!Pruebas/src/remote_monitoring/*.m
!Pruebas/src/remote_monitoring/README.md

# ── Whitelist: cerebro_digital (n8n + MQTT + InfluxDB) ──
!Pruebas/src/remote_monitoring/cerebro_digital/
!Pruebas/src/remote_monitoring/cerebro_digital/*.py
!Pruebas/src/remote_monitoring/cerebro_digital/*.yml
!Pruebas/src/remote_monitoring/cerebro_digital/*.md
!Pruebas/src/remote_monitoring/cerebro_digital/mosquitto/
!Pruebas/src/remote_monitoring/cerebro_digital/mosquitto/*.conf

!Pruebas/src/remote_monitoring/logs/
!Pruebas/src/remote_monitoring/logs/cdaq_remote_*.csv
!Pruebas/src/remote_monitoring/logs/cdaq_remote_*_inference.csv
!Pruebas/src/remote_monitoring/logs/cdaq_remote_*_cases.jsonl

# Ignorar logs de sesiones de prueba (no del hardware real)
Pruebas/src/remote_monitoring/logs/cdaq_remote_202605*.csv
Pruebas/src/remote_monitoring/logs/cdaq_remote_202605*_inference.csv
Pruebas/src/remote_monitoring/logs/cdaq_remote_202602*.csv
Pruebas/src/remote_monitoring/logs/cdaq_remote_202602*_inference.csv

# ── Whitelist: caracterizacion (reference) ──
!Pruebas/src/caracterizacion_sensor_fuerza.py
!Pruebas/src/caracterizacion_rugosimetro.py
!Pruebas/src/requirements_rugosimetro.txt
!Pruebas/src/ejecutar_rugosimetro_tmr200.bat

# ── Whitelist: levitador C++ (reference) ──
!levitador valentin/
!levitador valentin/*.cpp
!levitador valentin/*.h
!levitador valentin/Makefile

# ── Whitelist: levitador Python GUI ──
!levitador-python/
!levitador-python/*.py
!levitador-python/pinn/
!levitador-python/pinn/*.py

# ── Tesis doctoral y análisis Gemini ──
!analizar_tesis.py
!analizar_proyecto.py
!DOE_DESGASTE_CORTADOR_FINAL.md
!resultado_*.txt
!TESIS DOCTORAL 2025 SANTANA-RAMIREZ.docx
!Capitulo4_Resultados_Extendido.md
!GUIA_PROYECTO_IA.md
!Reporte_Noviembre_2024.md

# ── Reportes técnicos de diciembre ──
!Pruebas/README_RECONSTRUCCION_20251210.md
!Pruebas/Plan_Estructura_Semestral.md
!Pruebas/src/caracterizacion_fuerza/
!Pruebas/src/caracterizacion_fuerza/INFORME_HISTERESIS_FRESADO.md
!Pruebas/src/caracterizacion_fuerza/REPORTE_TECNICO_Caracterizacion_Dinamica.md
!Pruebas/src/caracterizacion_fuerza/README.md
!Pruebas/src/caracterizacion_fuerza/resumen_gemini/
!Pruebas/src/caracterizacion_fuerza/resumen_gemini/RESUMEN_ANALISIS_CORTE_CNC.md
!Pruebas/src/caracterizacion_fuerza/resumen_gemini/PROMPT_GEMINI.md

# ── Whitelist: razonador_casos (Razonador CBR) ──
!Pruebas/src/caracterizacion_fuerza/razonador_casos/
!Pruebas/src/caracterizacion_fuerza/razonador_casos/*.py
!Pruebas/src/caracterizacion_fuerza/razonador_casos/*.md
!Pruebas/src/caracterizacion_fuerza/razonador_casos/prompts/
!Pruebas/src/caracterizacion_fuerza/razonador_casos/prompts/*.md
!Pruebas/src/caracterizacion_fuerza/razonador_casos/n8n_local/
!Pruebas/src/caracterizacion_fuerza/razonador_casos/n8n_local/*.yml
!Pruebas/src/caracterizacion_fuerza/razonador_casos/n8n_local/*.md
!Pruebas/src/caracterizacion_fuerza/razonador_casos/n8n_local/*.json
# Razonador CBR en Simulink (fuentes MATLAB). El .mat/.slx se regeneran y se ignoran.
!Pruebas/src/caracterizacion_fuerza/razonador_casos/simulink_cbr/
!Pruebas/src/caracterizacion_fuerza/razonador_casos/simulink_cbr/*.m
!Pruebas/src/caracterizacion_fuerza/razonador_casos/simulink_cbr/*.md

# ── Whitelist: razonador_simulink (CBR + VLM orquestador, standalone) ──
!Pruebas/src/razonador_simulink/
!Pruebas/src/razonador_simulink/*.m
!Pruebas/src/razonador_simulink/*.md
!Pruebas/src/razonador_simulink/prompts/
!Pruebas/src/razonador_simulink/prompts/*.md
# Dataset de casos (se versiona el CSV; el .mat/.slx se regeneran)
!Pruebas/src/razonador_simulink/datos/
!Pruebas/src/razonador_simulink/datos/casos_historicos.csv
# Base de casos (dataset historico)
!Pruebas/src/caracterizacion_fuerza/razonador_casos/salidas/
!Pruebas/src/caracterizacion_fuerza/razonador_casos/salidas/casos_dataset/
!Pruebas/src/caracterizacion_fuerza/razonador_casos/salidas/casos_dataset/casos_historicos.csv
!Pruebas/src/caracterizacion_fuerza/razonador_casos/salidas/casos_dataset/casos_historicos.jsonl
!Pruebas/src/caracterizacion_fuerza/razonador_casos/salidas/casos_dataset/resumen_casos.md

# ── Contexto levitador (relevante para tesis) ──
!levitador valentin/*.md
!levitador-python/pinn/colab_files/
!levitador-python/pinn/colab_files/CONTEXTO_COMPLETO_PROYECTO.md
!levitador-python/pinn/colab_files/INDICE_MAESTRO.md
!levitador-python/pinn/colab_files/RESUMEN_RAPIDO_1_PAGINA.md
!levitador-python/pinn/README_BENCHMARK.md
!levitador-python/pinn/README_KAN_HYBRID.md

# ── Nunca subir credenciales ──
.env

# ── Always ignore these even if whitelisted ──
__pycache__/
*.py[cod]
*.pyo
.DS_Store
Thumbs.db
